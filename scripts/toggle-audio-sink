#!/bin/bash
# Toggle default audio sink between Laptop Speakers and Monitor

LAPTOP_SINK="alsa_output.pci-0000_63_00.6.analog-stereo"
MONITOR_SINK="alsa_output.pci-0000_63_00.1.hdmi-stereo-extra1"

CURRENT=$(pactl get-default-sink)

if [ "$CURRENT" = "$MONITOR_SINK" ]; then
    pactl set-default-sink "$LAPTOP_SINK"
    echo "Switched to Laptop Speakers"
else
    pactl set-default-sink "$MONITOR_SINK"
    echo "Switched to Monitor Speakers"
fi
