#!/bin/bash
# Silent / Fanless Mode for Lenovo Yoga Pro 7 / IdeaPad Pro 5 (Ryzen 7 7840HS)
# Keeps the laptop cool, passive, and completely fanless (0 RPM) under daily workloads.

if [ "$EUID" -ne 0 ]; then
    echo "[!] Please run with sudo: sudo ~/.local/bin/silent-mode"
    exit 1
fi

echo "[+] Setting ACPI Platform Profile to Quiet (Low Power)..."
if [ -f /sys/firmware/acpi/platform_profile ]; then
    echo low-power > /sys/firmware/acpi/platform_profile
fi
if command -v powerprofilesctl >/dev/null 2>&1; then
    powerprofilesctl set power-saver 2>/dev/null || true
fi

echo "[+] Setting CPU governor to powersave & EPP to power..."
for gov in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
    [ -f "$gov" ] && echo powersave > "$gov"
done
for epp in /sys/devices/system/cpu/cpu*/cpufreq/energy_performance_preference; do
    [ -f "$epp" ] && echo power > "$epp"
done

echo "[+] Disabling CPU Turbo Boost (caps at 3.8 GHz base clock to eliminate thermal spikes)..."
if [ -f /sys/devices/system/cpu/cpufreq/boost ]; then
    echo 0 > /sys/devices/system/cpu/cpufreq/boost
fi

echo "[+] Setting GPU DPM to auto..."
for dpm in /sys/class/drm/card*/device/power_dpm_force_performance_level; do
    [ -f "$dpm" ] && echo auto > "$dpm"
done

echo "[+] Setting PCIe ASPM to powersave..."
if [ -f /sys/module/pcie_aspm/parameters/policy ]; then
    echo powersave > /sys/module/pcie_aspm/parameters/policy 2>/dev/null || true
fi

echo "[+] Capping TDP to 15W and Tctl to 48°C with -20 Undervolt via RyzenAdj..."
RYZENADJ="/home/suiseika/.local/bin/ryzenadj"
if [ -x "$RYZENADJ" ]; then
    # 15W sustained power limit + 48°C hard temp ceiling
    # Passively dissipates through the chassis without triggering fans
    "$RYZENADJ" \
        --stapm-limit=15000 \
        --slow-limit=15000 \
        --fast-limit=20000 \
        --tctl-temp=48 \
        --apu-skin-temp=48 \
        --set-coall=0xFFFFFFEC \
        --set-cogfx=0xFFFFFFEC \
        --power-saving 2>&1 | grep -v "no compatible ryzen_smu" || true
fi

echo "[✔] Fanless / Silent Mode active! (Boost off, 15W TDP, 48°C ceiling, undervolted)"
