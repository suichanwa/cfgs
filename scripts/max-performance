#!/bin/bash
# Extreme Max Performance Script for Lenovo Yoga Pro 7 14APH8 (Ryzen 7 7840HS + Radeon 780M)

if [ "$EUID" -ne 0 ]; then
    echo "[!] Please run with sudo: sudo ~/.local/bin/max-performance"
    exit 1
fi

echo "[+] Setting ACPI Platform Profile to Extreme Performance..."
if [ -f /sys/firmware/acpi/platform_profile ]; then
    echo performance > /sys/firmware/acpi/platform_profile
fi
if command -v powerprofilesctl >/dev/null 2>&1; then
    powerprofilesctl set performance 2>/dev/null || true
fi

echo "[+] Setting CPU scaling governors & EPP to performance on all cores..."
for gov in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
    [ -f "$gov" ] && echo performance > "$gov"
done
for epp in /sys/devices/system/cpu/cpu*/cpufreq/energy_performance_preference; do
    [ -f "$epp" ] && echo performance > "$epp"
done
if [ -f /sys/devices/system/cpu/cpufreq/boost ]; then
    echo 1 > /sys/devices/system/cpu/cpufreq/boost
fi

echo "[+] Locking AMD Radeon 780M GPU to highest performance level..."
for dpm in /sys/class/drm/card*/device/power_dpm_force_performance_level; do
    [ -f "$dpm" ] && echo high > "$dpm"
done

echo "[+] Setting PCIe ASPM to performance mode..."
if [ -f /sys/module/pcie_aspm/parameters/policy ]; then
    echo performance > /sys/module/pcie_aspm/parameters/policy 2>/dev/null || true
fi

echo "[+] Setting Ryzen 7 7840HS to 50W Performance Preset (88°C thermal limit, 45W-48W sustained / 50W max burst)..."
RYZENADJ="/home/suiseika/.local/bin/ryzenadj"
if [ -x "$RYZENADJ" ]; then
    "$RYZENADJ" \
        --stapm-limit=45000 \
        --slow-limit=48000 \
        --fast-limit=50000 \
        --slow-time=64 \
        --stapm-time=600 \
        --tctl-temp=88 \
        --apu-skin-temp=88 \
        --vrm-current=100000 \
        --vrmmax-current=125000 \
        --vrmsoc-current=40000 \
        --vrmsocmax-current=55000 \
        --vrmgfx-current=60000 \
        --vrmgfxmax_current=75000 \
        --max-fclk-frequency=2000 \
        --max-gfxclk=2800 \
        --set-coall=0xFFFFFFEC \
        --set-cogfx=0xFFFFFFEC \
        --max-performance 2>&1 | grep -v "no compatible ryzen_smu" || true
fi

echo "[+] Setting Transparent Hugepages & low swappiness..."
if [ -f /sys/kernel/mm/transparent_hugepage/enabled ]; then
    echo always > /sys/kernel/mm/transparent_hugepage/enabled
fi
sysctl -w vm.swappiness=10 >/dev/null 2>&1 || true

echo "[✔] Performance preset active! Capped at 50W max (45W/48W sustained) with 88°C thermal ceiling."
