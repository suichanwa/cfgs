#!/usr/bin/env bash
# High-performance game/screen recording script for Sway on AMD
set -e

REC_DIR="$HOME/Videos/Recordings"
mkdir -p "$REC_DIR"
PID_FILE="/tmp/game_recording.pid"

# Set default microphone behavior (0 = off by default, 1 = on by default)
RECORD_MIC="${RECORD_MIC:-0}"

# Function to stop any active recording cleanly
stop_recording() {
    local stopped=0
    if [ -f "$PID_FILE" ]; then
        local pid
        pid=$(cat "$PID_FILE" 2>/dev/null || true)
        if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
            echo "Stopping recording (PID $pid)..."
            kill -SIGINT "$pid" 2>/dev/null || true
            stopped=1
        fi
        rm -f "$PID_FILE"
    fi

    # Catch any stray instances
    if pkill -SIGINT -f "gpu-screen-recorder" 2>/dev/null || pkill -SIGINT -f "wf-recorder" 2>/dev/null; then
        stopped=1
    fi

    if [ "$stopped" -eq 1 ]; then
        echo "Recording stopped and saved to ~/Videos/Recordings/"
        notify-send -u normal -i media-record -t 3000 "Screen Recorder" "Recording saved to ~/Videos/Recordings!" &
    else
        echo "No active screen recording was found."
    fi
}

# If user typed 'record stop' or 'record --stop'
if [[ "$1" == "stop" || "$1" == "--stop" || "$1" == "-s" ]]; then
    stop_recording
    exit 0
fi

# Toggle: If already recording, stop it immediately
if [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE" 2>/dev/null)" 2>/dev/null; then
    stop_recording
    exit 0
fi

if pgrep -f "gpu-screen-recorder" >/dev/null 2>&1 || pgrep -f "wf-recorder" >/dev/null 2>&1; then
    stop_recording
    exit 0
fi

# Parse --mic or -m flag
ENABLE_MIC=$RECORD_MIC
if [[ "$1" == "--mic" || "$1" == "-m" || "$1" == "mic" ]]; then
    ENABLE_MIC=1
    shift
elif [[ "$1" == "--no-mic" ]]; then
    ENABLE_MIC=0
    shift
fi

# Detect installed recorder engine
if command -v gpu-screen-recorder >/dev/null 2>&1; then
    RECORDER="gpu-screen-recorder"
elif command -v wf-recorder >/dev/null 2>&1; then
    RECORDER="wf-recorder"
else
    echo "Error: Neither gpu-screen-recorder nor wf-recorder is installed."
    echo "Install with: sudo pacman -S gpu-screen-recorder"
    notify-send -u critical -i dialog-error "Screen Recorder" "Please install gpu-screen-recorder:\nsudo pacman -S gpu-screen-recorder" &
    exit 1
fi

TIMESTAMP=$(date +"%Y-%m-%d_%H-%M-%S")
OUTPUT_FILE="$REC_DIR/recording_${TIMESTAMP}.mp4"

# Get focused output in Sway (e.g. HDMI-A-1 or eDP-1)
FOCUSED_OUTPUT=$(swaymsg -t get_outputs 2>/dev/null | jq -r '.[] | select(.focused) | .name' 2>/dev/null || echo "HDMI-A-1")
[ -z "$FOCUSED_OUTPUT" ] && FOCUSED_OUTPUT="HDMI-A-1"

if [ "$ENABLE_MIC" -eq 1 ]; then
    AUDIO_DESC="Game Audio + Mic: ON | 60 FPS"
    GSR_AUDIO="default_output|default_input"
else
    AUDIO_DESC="Game Audio: ON (Mic OFF) | 60 FPS"
    GSR_AUDIO="default_output"
fi

notify-send -u normal -i media-record -t 2500 "Screen Recorder" "Recording started on $FOCUSED_OUTPUT\n$AUDIO_DESC" &

if [ "$RECORDER" = "gpu-screen-recorder" ]; then
    # Hardware-accelerated AMD VCN/VAAPI encoding
    gpu-screen-recorder -w "$FOCUSED_OUTPUT" -f 60 -a "$GSR_AUDIO" -c mp4 -o "$OUTPUT_FILE" "$@" >/dev/null 2>&1 &
    REC_PID=$!
else
    AUDIO_SINK="$(pactl get-default-sink 2>/dev/null).monitor"
    wf-recorder -o "$FOCUSED_OUTPUT" -c h264_vaapi -d /dev/dri/renderD128 -a "$AUDIO_SINK" -f "$OUTPUT_FILE" "$@" >/dev/null 2>&1 &
    REC_PID=$!
fi

echo "$REC_PID" > "$PID_FILE"
echo "Recording started: $OUTPUT_FILE (PID $REC_PID)"
echo "Mode: $AUDIO_DESC"
echo "To stop: Run 'record' again, or press Win+Shift+R"
